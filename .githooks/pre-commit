#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "pre-commit: started"

STAGED_JAVA_FILES="$(git diff --cached --name-only --diff-filter=ACM -- '*.java')"

if [ -z "$STAGED_JAVA_FILES" ]; then
  echo "pre-commit: no staged Java files, skipping"
  exit 0
fi

echo "pre-commit: staged Java files:"
echo "$STAGED_JAVA_FILES"

echo "pre-commit: running spotlessApply..."
./gradlew spotlessApply --quiet

echo "$STAGED_JAVA_FILES" | xargs git add

echo "pre-commit: done"